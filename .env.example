# Postgres connection string. Production: Neon's POOLED connection string.
# Local: `npm run db:local` serves PGlite on port 5433:
#   postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable
DATABASE_URL=

# The dashboard is public to view. OWNER_PASSWORD unlocks adding, editing and deleting
# (and Settings / Garmin Refresh) for 30 days in the browser that enters it.
OWNER_PASSWORD=

# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 36`.
# Changing it signs everyone out.
SESSION_SECRET=

# Garmin Personal API key (lib/garmin/): Garmin Connect Web > Personal API Key > Create Key.
# Expires after 30 days to 1 year; replace it here and in Vercel when it does.
GARMIN_PERSONAL_ACCESS_TOKEN=

# Vercel only: Vercel Cron sends it as a bearer token to /api/garmin/cron (the nightly
# import), which refuses any other caller. Any long random string.
# CRON_SECRET=

# Gemini API key for the AI daily summary (lib/summary/), written once each morning by the
# summary cron. Free, no card: aistudio.google.com/apikey. On the free tier Google may use the
# summary facts to improve its products.
GEMINI_API_KEY=
