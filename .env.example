# Supabase project URL and publishable (anon) key. Nothing else is needed for V0.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The service-role key: local, uncommitted use only. Normally it's read solely by scripts/
# (seed-demo.ts, the Garmin importer) — DISABLE_AUTH below is the one deliberate exception
# that also has the deployed app itself read it, via lib/supabase/service-role.ts.
# SUPABASE_SERVICE_ROLE_KEY=

# Temporary, local development only (ignored by production builds): skip the login screen,
# and optionally sign in automatically as one existing account.
# DEV_SKIP_LOGIN=true
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=

# A SEPARATE switch (see lib/supabase/dev-login.ts's isAuthDisabled doc comment): allowed in
# production, unlike DEV_SKIP_LOGIN above. Skips the login wall for the whole deployed app —
# anyone with the URL sees real data, no sign-in of any kind — while the real login screen and
# RLS access control stay in the code, unremoved, for whenever it's turned back off. Needs
# SUPABASE_SERVICE_ROLE_KEY above to also be set.
# DISABLE_AUTH=true

# The dashboard's "Refresh" button (app/api/garmin/refresh/route.ts): a GitHub fine-grained
# personal access token, scoped to ONLY this repo, with "Actions: Read and write" permission
# and nothing else. Used to dispatch and poll .github/workflows/garmin-nightly.yml on demand —
# see that route's own comment for why this can't just run the Python import in-process.
# GARMIN_REFRESH_TOKEN=
