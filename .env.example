# Supabase project URL and publishable (anon) key. Nothing else is needed for V0.
# The service-role key is never set here: it only ever lives in a local, uncommitted
# env file used by scripts/seed-demo.ts against a DEV project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Temporary, local development only (ignored by production builds): skip the login screen,
# and optionally sign in automatically as one existing account.
# DEV_SKIP_LOGIN=true
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=
