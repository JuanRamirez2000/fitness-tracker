# Postgres connection string. Production: Neon's POOLED connection string.
# Local: `npm run db:local` serves PGlite on port 5433:
#   postgres://postgres:postgres@localhost:5433/postgres?sslmode=disable
DATABASE_URL=

# The dashboard is public to view. OWNER_PASSWORD unlocks adding, editing and deleting
# (and Settings / Garmin Refresh) for 30 days in the browser that enters it.
OWNER_PASSWORD=

# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -base64 36`.
# Changing it signs everyone out.
SESSION_SECRET=

# The dashboard's "Refresh" button (app/api/garmin/refresh/route.ts): a GitHub fine-grained
# personal access token, scoped to ONLY this repo, with "Actions: Read and write" permission
# and nothing else. Used to dispatch and poll .github/workflows/garmin-nightly.yml on demand —
# see that route's own comment for why this can't just run the Python import in-process.
# GARMIN_REFRESH_TOKEN=
